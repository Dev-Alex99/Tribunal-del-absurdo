# =====================================================================
# TRIBUNAL DEL ABSURDO — CONFIGURACIÓN DEL SISTEMA JUDICIAL
# =====================================================================

# Puerto del servidor backend (Express + Socket.io)
PORT=3001

# MiniMax M3.1 Flash API Key
# INSTRUCCIÓN: Coloca aquí tu clave de API de MiniMax (ej. "sk-...")
# Si se deja vacía, el servidor funciona en MODO SIMULADOR AUTOMÁTICO
# con expedientes cómicos y deliberaciones precargadas.
MINIMAX_API_KEY=

# Base URL de la API de MiniMax (compatible con OpenAI standard)
MINIMAX_BASE_URL=https://api.minimax.io/v1

# Modelo MiniMax a emplear
MINIMAX_MODEL=MiniMax-M3.1-Flash

# Tiempos de cada fase judicial (en segundos)
# Diseñado para permitir a jugadores con 400ms+ de ping jugar sin apuros
BRIEFING_TIME_SECONDS=18
WRITING_TIME_SECONDS=75
VERDICT_TIME_SECONDS=35
TOTAL_ROUNDS=3
